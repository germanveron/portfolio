---
import type { Site } from '../content/types';
import { links } from '../content/shared';

interface Props { t: Site }
const { t } = Astro.props;
const c = t.contact;
---
<section class="section contact" id={t.ids.contact} data-section="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <h2 id="contact-title">{c.title}</h2>
    <p class="contact-text">{c.text}</p>
    <p class="direct">
      <a href={`mailto:${links.email}`}>{links.email}</a>
      <a href={`tel:${links.phone.replace(/\s/g, "")}`}>{links.phone}</a>
    </p>
    <div class="contact-actions">
      <a class="btn btn-primary" href={`mailto:${links.email}`}>{c.mail}</a>
      <a class="btn btn-secondary" href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a class="btn btn-secondary" href={links.cvEs} download lang="es">{c.cvEs}</a>
      <a class="btn btn-secondary" href={links.cvEn} download lang="en">{c.cvEn}</a>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="wrap footer-inner">
    <span>© 2026 {t.intro.name}</span>
    <span>{t.footer.built}</span>
  </div>
</footer>

<style>
  .contact { background: var(--mist); }
  .contact h2 { font-size: clamp(2.1rem, 3.6vw, var(--t-3xl)); }
  .contact-text { margin-top: 16px; font-size: var(--t-md); color: var(--graphite); max-width: 56ch; }
  .direct { margin-top: 24px; display: flex; flex-wrap: wrap; gap: 8px 32px; font-size: var(--t-md); font-weight: 600; letter-spacing: -0.01em; }
  .direct a { color: var(--ink); text-decoration-thickness: 1.5px; }
  .direct a:hover { color: var(--isar); }
  .contact-actions { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 12px; }

  .footer { border-top: 1px solid var(--line); }
  .footer-inner {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px;
    padding-top: 24px; padding-bottom: 24px;
    font-size: var(--t-sm); color: var(--graphite);
  }
</style>
