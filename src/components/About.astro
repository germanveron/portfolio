---
import type { Site } from '../content/types';

interface Props { t: Site; photo?: ImageMetadata }
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
const { t, photo } = Astro.props;
const a = t.about;
---
<section class="section" id={t.ids.about} data-section="about" aria-labelledby="about-title">
  <div class="wrap about">
    <div class="about-photo">
      {photo ? (
        <Image src={photo} alt={t.intro.name} widths={[400, 800]} sizes="320px" class="photo" />
      ) : (
        <div class="pending photo-pending">{a.photoPending}</div>
      )}
    </div>

    <div class="about-text">
      <h2 id="about-title">{a.title}</h2>
      <p class="about-intro">{a.intro}</p>
      {a.blocks.map((b) => (
        <div class="block">
          <h3>{b.title}</h3>
          <p>{b.text}</p>
        </div>
      ))}

      <dl class="facts">
        {a.facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="about-certs">
      <h3>{a.certsTitle}</h3>
      <ul class="certs">{a.certs.map((c) => <li>{c}</li>)}</ul>
    </div>
  </div>
</section>

<style>
  /* The photo is as tall as the text up to the facts; certifications run below it */
  .about {
    display: grid;
    grid-template-columns: 340px minmax(0, 1fr);
    grid-template-areas: "photo text" ". certs";
    column-gap: 72px;
  }
  .about-photo { grid-area: photo; position: relative; min-height: 420px; }
  .about-text { grid-area: text; }
  .about-certs { grid-area: certs; margin-top: 40px; max-width: 68ch; }
  .about-certs h3 { font-size: var(--t-md); letter-spacing: -0.015em; }
  .about-photo :global(.photo), .photo-pending {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: var(--r-shot);
  }
  .about-text { max-width: 68ch; }
  .about-text h2 { font-size: clamp(2.1rem, 3.6vw, var(--t-3xl)); }
  .about-intro { margin-top: 24px; font-size: var(--t-md); line-height: 1.5; color: var(--ink); }
  .block { margin-top: 36px; }
  .block h3 { font-size: var(--t-md); letter-spacing: -0.015em; }
  .block p { margin-top: 8px; }

  .facts {
    margin: 40px 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 32px;
  }
  .facts div { padding: 14px 0; border-top: 1px solid var(--line); }
  .facts dt { font-size: var(--t-sm); color: var(--graphite); }
  .facts dd { margin: 2px 0 0; color: var(--ink); font-weight: 560; }

  .certs { margin-top: 10px; padding-left: 1.1em; display: grid; gap: 6px; }

  @media (max-width: 860px) {
    .about { grid-template-columns: 1fr; grid-template-areas: "photo" "text" "certs"; row-gap: 32px; }
    .about-certs { margin-top: 8px; }
    .about-photo { min-height: 0; max-width: 220px; aspect-ratio: 4 / 5; }
    .facts { grid-template-columns: 1fr; }
  }
</style>
