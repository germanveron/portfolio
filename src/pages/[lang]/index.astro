---
import type { ImageMetadata } from 'astro';
import { es } from '../../content/es';
import { en } from '../../content/en';
import { links } from '../../content/shared';
import Base from '../../layouts/Base.astro';
import CaseTile from '../../components/CaseTile.astro';
import Experience from '../../components/Experience.astro';
import Tools from '../../components/Tools.astro';
import About from '../../components/About.astro';
import Contact from '../../components/Contact.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params;
const t = lang === 'es' ? es : en;
const other = lang === 'es' ? en : es;

// Photo: add src/assets/photo.jpg and it shows up automatically.
const photoFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/photo.{jpg,jpeg,png,webp}', { eager: true });
const photo = Object.values(photoFiles)[0]?.default;

// Display order of the cases (ids are the same in both languages)
const order = ['bitacora', 'resenas', 'entrevistas', 'agente-bugs', 'informe-resenas'];
const sorted = [...t.cases].sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
const products = sorted.filter((c) => c.kind === 'product');
const flows = sorted.filter((c) => c.kind === 'flow');
const cv = lang === 'es' ? links.cvEs : links.cvEn;
---
<Base t={t} other={other} title={t.meta.title} description={t.meta.description} paths={{ es: '/es/', en: '/en/' }} home>
    <main id="main">
      <section class="intro" id={t.ids.top} data-section="top">
        <div class="wrap intro-body">
          <h1>{t.intro.title.split('\n').map((line) => <span class="h1-line">{line}</span>)}</h1>
          <p class="intro-lead">{t.intro.lead}</p>
          <p class="intro-location">{t.intro.location}</p>
          <a class="btn btn-secondary btn-sm intro-cv" href={cv} download>{t.intro.ctaCv}</a>
        </div>
        <!-- The main call to action sits at the bottom of the first screen and points down to the cases -->
        <a class="intro-next" href={`#${t.ids.ai}`}>
          <span class="btn btn-primary">{t.intro.ctaCases}</span>
          <svg class="cue" aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><path d="M5 8l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </section>

      <section class="ai" id={t.ids.ai} data-section="ai" aria-labelledby="ai-title">
        <div class="wrap">
          <div class="section-head">
            <h2 id="ai-title">{t.ai.title}</h2>
            <p>{t.ai.lead}</p>
          </div>
        </div>
        <div class="cases">
          {products.map((c) => <CaseTile c={c} t={t} />)}
          {flows.map((c) => <CaseTile c={c} t={t} />)}
        </div>
      </section>

      <Experience t={t} />
      <Tools t={t} />
      <About t={t} photo={photo} />
      <Contact t={t} />
    </main>
</Base>

<style>
  /* The intro fills the first screen on its own; the main CTA sits at its bottom and points down */
  .intro {
    min-height: calc(100svh - var(--nav-h));
    display: flex;
    flex-direction: column;
    padding: 64px 0 32px;
    scroll-margin-top: var(--nav-h);
  }
  .intro-body { width: 100%; margin-block: auto; }
  .intro h1 {
    font-size: clamp(2.6rem, 5.6vw, var(--t-4xl));
    font-weight: 680;
    letter-spacing: -0.032em;
    line-height: 1.02;
  }
  /* The headline keeps its three lines on wide screens */
  .h1-line { display: block; }
  .intro-lead {
    margin-top: 28px;
    max-width: 60ch;
    font-size: var(--t-md);
    line-height: 1.5;
    color: var(--graphite);
  }
  .intro-location { margin-top: 24px; font-size: var(--t-sm); color: var(--graphite); }
  .intro-cv { margin-top: 14px; }

  .intro-next {
    align-self: center;
    margin-top: 56px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: var(--graphite);
    text-decoration: none;
  }
  .intro-next:hover .btn-primary { background: var(--isar-hover); }
  .intro-next:hover { color: var(--ink); }
  .cue { animation: cue 1.8s ease-in-out infinite; }
  @keyframes cue {
    0%, 100% { transform: translateY(0); opacity: 0.55; }
    50% { transform: translateY(6px); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .cue { animation: none; } }

  .ai {
    padding-top: 32px;
    padding-bottom: 128px;
    scroll-margin-top: var(--nav-h);
  }
  /* Same outer edges as the text column, so everything shares one margin */
  .cases {
    max-width: calc(var(--wrap) + var(--gutter) * 2);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .cases > :global(.tile--product) { grid-column: 1 / -1; }

  @media (max-width: 860px) {
    .cases { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 720px) {
    .intro { padding: 48px 0 24px; }
    .ai { padding-bottom: 88px; }
    .cases { gap: 8px; }
  }
</style>
